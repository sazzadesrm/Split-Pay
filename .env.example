APP_NAME="Split Pay"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=splitpay
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

SESSION_NAME=splitpay_session
SESSION_LIFETIME=7200
SESSION_SECURE_COOKIE=false

STORAGE_PATH=./storage
RECEIPT_STORAGE_PATH=./storage/receipts
AVATAR_STORAGE_PATH=./storage/avatars

MAX_RECEIPT_UPLOAD_SIZE=10485760
PASSWORD_RESET_EXPIRY_MINUTES=60
INVITATION_EXPIRY_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

MAIL_DRIVER=log
MAIL_FROM_ADDRESS=no-reply@splitpay.test
MAIL_FROM_NAME="Split Pay"
