{
    "name": "splitpay/split-pay",
    "description": "Split Pay - Shared Expense Tracking and Reimbursement Platform for Small Teams",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-fileinfo": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-json": "*",
        "ext-ctype": "*",
        "ext-filter": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Core/helpers.php"
        ]
    },
    "scripts": {
        "test": "phpunit --testdox",
        "migrate": "php database/migrate.php",
        "migrate:seed": "php database/migrate.php --seed"
    }
}
